//#include <behaviors/unicode.dtsi> /* Include the Unicode module */

#include <dt-bindings/zmk/oskey.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        Genpd1 {
            bindings = <&wp1>;
            key-positions = <22 34 48>;
            layers = <2>;
        };

        Genpd2 {
            bindings = <&wp2>;
            key-positions = <21 33 47>;
            layers = <2>;
        };

        cmbRaycast {
            bindings = <&kp LA(ENTER)>;
            key-positions = <54 55>;
            layers = <0>;
        };

        ToDef {
            bindings = <&to 0>;
            key-positions = <15 27 39>;
        };

        ToMouse {
            bindings = <&to 3>;
            key-positions = <14 26 38>;
        };

        ToNav {
            bindings = <&to 2>;
            key-positions = <13 25 37>;
        };

        CmbRaycastChat {
            bindings = <&kp LA(SPACE)>;
            key-positions = <53 56>;
            layers = <0>;
        };

        cmbRepeatL {
            bindings = <&key_repeat>;
            key-positions = <39 40>;
            timeout-ms = <50>;
        };

        cmbRepeatR {
            bindings = <&key_repeat>;
            key-positions = <45 46>;
            timeout-ms = <50>;
        };
    };

    macros {
        wp1: wp1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp AT &kp LS(T) &kp I &kp N0 &kp N2 &kp C &kp A &kp N0 &kp N9 &kp RET>;
            label = "WP1";
        };

        wp2: wp2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp AT &kp LS(A) &kp N &kp H &kp K &kp H &kp O &kp I &kp N1 &kp N4 &kp B &kp E &kp N &kp G &kp O &kp C &kp RET>;
            label = "WP2";
        };
    };

    behaviors {
        ///// Start OS KKey  ///////////////////
        /* ── OS selector ────────────────────────────────────────────── */

        os_sel: os_selector {
            compatible = "zmk,behavior-os-selector";
            #binding-cells = <1>;
        };

        /* ── Commands ─────────────────────────────────────────────── */

        ok_cut: os_key_cut {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(X)>, <&kp LG(X)>, <&kp LC(X)>;
        };

        ok_copy: os_key_copy {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(C)>, <&kp LG(C)>, <&kp LC(C)>;
        };

        ok_paste: os_key_paste {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(V)>, <&kp LG(V)>, <&kp LC(V)>;
        };

        ok_undo: os_key_undo {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(Z)>, <&kp LG(Z)>, <&kp LC(Z)>;
        };

        ok_redo: os_key_redo {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win         Mac                Lin  */

            bindings = <&kp LC(Y)>, <&kp LS(LG(Z))>, <&kp LS(LC(Z))>;
        };

        ok_sel_all: os_key_select_all {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(A)>, <&kp LG(A)>, <&kp LC(A)>;
        };

        ok_find: os_key_find {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(F)>, <&kp LG(F)>, <&kp LC(F)>;
        };

        ok_find_replace: os_key_find_replace {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(H)>, <&kp LG(H)>, <&kp LC(H)>;
        };

        ok_bold: os_key_bold {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(B)>, <&kp LG(B)>, <&kp LC(B)>;
        };

        ok_italic: os_key_italic {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(I)>, <&kp LG(I)>, <&kp LC(I)>;
        };

        ok_underline: os_key_underline {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(U)>, <&kp LG(U)>, <&kp LC(U)>;
        };

        ok_new_win: os_key_new_window {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(N)>, <&kp LG(N)>, <&kp LC(N)>;
        };

        ok_new_tab: os_key_new_tab {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(T)>, <&kp LG(T)>, <&kp LC(T)>;
        };

        ok_close: os_key_close {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(W)>, <&kp LG(W)>, <&kp LC(W)>;
        };

        ok_quit: os_key_quit {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win            Mac           Lin  */

            bindings = <&kp LA(F4)>, <&kp LG(Q)>, <&kp LA(F4)>;
        };

        ok_reopen_tab: os_key_reopen_tab {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                  Win                Mac               Lin  */

            bindings = <&kp LS(LC(T))>, <&kp LS(LG(T))>, <&kp LS(LC(T))>;
        };

        ok_open: os_key_open {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(O)>, <&kp LG(O)>, <&kp LC(O)>;
        };

        ok_save: os_key_save {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(S)>, <&kp LG(S)>, <&kp LC(S)>;
        };

        ok_save_as: os_key_save_as {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                  Win                Mac               Lin  */

            bindings = <&kp LS(LC(S))>, <&kp LS(LG(S))>, <&kp LS(LC(S))>;
        };

        ok_print: os_key_print {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac           Lin  */

            bindings = <&kp LC(P)>, <&kp LG(P)>, <&kp LC(P)>;
        };

        ok_zoom_in: os_key_zoom_in {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                Win              Mac              Lin  */

            bindings = <&kp LC(EQUAL)>, <&kp LG(EQUAL)>, <&kp LC(EQUAL)>;
        };

        ok_zoom_out: os_key_zoom_out {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                Win              Mac              Lin  */

            bindings = <&kp LC(MINUS)>, <&kp LG(MINUS)>, <&kp LC(MINUS)>;
        };

        ok_zoom_reset: os_key_zoom_reset {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win            Mac            Lin  */

            bindings = <&kp LC(N0)>, <&kp LG(N0)>, <&kp LC(N0)>;
        };

        /* ── Navigation ─────────────────────────────────────────────── */

        ok_prev_word: os_key_prev_word {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                  Win            Mac            Lin  */

            bindings = <&kp LC(LEFT)>, <&kp LA(LEFT)>, <&kp LC(LEFT)>;
        };

        ok_next_word: os_key_next_word {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                  Win             Mac             Lin  */

            bindings = <&kp LC(RIGHT)>, <&kp LA(RIGHT)>, <&kp LC(RIGHT)>;
        };

        ok_line_start: os_key_line_start {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*              Win          Mac             Lin  */

            bindings = <&kp HOME>, <&kp LG(LEFT)>, <&kp HOME>;
        };

        ok_line_end: os_key_line_end {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*             Win           Mac              Lin  */

            bindings = <&kp END>, <&kp LG(RIGHT)>, <&kp END>;
        };

        ok_doc_start: os_key_doc_start {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                Win           Mac          Lin  */

            bindings = <&kp LC(HOME)>, <&kp LG(UP)>, <&kp LC(HOME)>;
        };

        ok_doc_end: os_key_doc_end {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*               Win             Mac            Lin  */

            bindings = <&kp LC(END)>, <&kp LG(DOWN)>, <&kp LC(END)>;
        };

        /* ── Selection (Shift + Navigation) ─────────────────────────── */

        ok_sel_prev_word: os_key_sel_prev_word {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                       Win                   Mac                   Lin  */

            bindings =
                <&kp LS(LC(LEFT))>,
                <&kp LS(LA(LEFT))>,
                <&kp LS(LC(LEFT))>;
        };

        ok_sel_next_word: os_key_sel_next_word {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                        Win                    Mac                    Lin  */

            bindings =
                <&kp LS(LC(RIGHT))>,
                <&kp LS(LA(RIGHT))>,
                <&kp LS(LC(RIGHT))>;
        };

        ok_sel_line_start: os_key_sel_line_start {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                   Win              Mac                Lin  */

            bindings = <&kp LS(HOME)>, <&kp LS(LG(LEFT))>, <&kp LS(HOME)>;
        };

        ok_sel_line_end: os_key_sel_line_end {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                  Win             Mac                 Lin  */

            bindings = <&kp LS(END)>, <&kp LS(LG(RIGHT))>, <&kp LS(END)>;
        };

        ok_sel_doc_start: os_key_sel_doc_start {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                     Win                Mac               Lin  */

            bindings = <&kp LS(LC(HOME))>, <&kp LS(LG(UP))>, <&kp LS(LC(HOME))>;
        };

        ok_sel_doc_end: os_key_sel_doc_end {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                    Win                 Mac                Lin  */

            bindings = <&kp LS(LC(END))>, <&kp LS(LG(DOWN))>, <&kp LS(LC(END))>;
        };

        /* ── Window management ───────────────────────────────────────── */
        /* Linux shortcuts are DE-specific; override in your keymap.     */

        ok_ltm: os_layer_mod {
            compatible = "zmk,behavior-os-layer-mod";
            #binding-cells = <2>;

            /*
             * Hold: activates <layer> and holds the OS app-switch modifier,
             *   keeping the switcher menu open while held.
             * Tap: sends <keycode> normally.
             * Release: dismisses the switcher menu and deactivates the layer.
             *
             * Usage:  &ok_ltm APP_SWITCH_LAYER G
             *
             * Override mods in your keymap to use different modifiers.
             */

            tapping-term-ms = <200>;

            /*              Win           Mac           Lin  */

            bindings = <&kp LALT>, <&kp LGUI>, <&kp LGUI>;
        };

        ok_next_app: os_key_next_app {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*            Win           Mac           Lin  */

            bindings = <&kp LA(TAB)>, <&kp LG(TAB)>, <&kp LG(TAB)>;
        };

        ok_prev_app: os_key_prev_app {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*            Win           Mac           Lin  */

            bindings = <&kp LS(LA(TAB))>, <&kp LS(LG(TAB))>, <&kp LS(LG(TAB))>;
        };

        ok_next_tab: os_key_next_tab {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*            Win           Mac              Lin  */

            bindings = <&kp LC(RBRC)>, <&kp LG(RBRC)>, <&kp LC(PG_DN)>;
        };

        ok_prev_tab: os_key_prev_tab {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*            Win           Mac              Lin  */

            bindings = <&kp LC(LBRC)>, <&kp LG(LBRC)>, <&kp LC(PG_UP)>;
        };

        ok_mission_ctrl: os_key_mission_control {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                 Win            Mac          Lin (DE-specific) */

            bindings = <&kp LG(TAB)>, <&kp LC(UP)>, <&kp LGUI>;
        };

        ok_desktop: os_key_desktop {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*              Win           Mac             Lin (DE-specific) */

            bindings = <&kp LG(D)>, <&kp LG(LC(D))>, <&kp LG(D)>;
        };

        ok_lock: os_key_lock {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*               Win           Mac              Lin (Ubuntu/GNOME default) */

            bindings = <&kp LG(L)>, <&kp LG(LC(Q))>, <&kp LG(L)>;
        };

        ok_force_quit: os_key_force_quit {
            compatible = "zmk,behavior-os-key";
            #binding-cells = <0>;

            /*                  Win (Task Mgr)    Mac (Force Quit)    Lin (KDE: Sys Activity) */

            bindings = <&kp LS(LC(ESC))>, <&kp LA(LG(ESC))>, <&kp LC(ESC)>;
        };

        ///// Finish OS KKey  ///////////////////

        leader1: leader1 {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;

            usb {
                sequence = <U S B>;
                bindings = <&out OUT_USB>;
            };

            ble {
                sequence = <B L E>;
                bindings = <&out OUT_BLE>;
            };

            bt0 {
                sequence = <B N0>;
                bindings = <&bt BT_SEL 0>;
            };

            bt1 {
                sequence = <B N1>;
                bindings = <&bt BT_SEL 1>;
            };

            bt2 {
                sequence = <B N2>;
                bindings = <&bt BT_SEL 2>;
            };

            btc {
                sequence = <C L E A R>;
                bindings = <&bt BT_CLR>;
            };

            boot {
                sequence = <B O O T>;
                bindings = <&bootloader>;
            };

            reset {
                sequence = <R E S E T>;
                bindings = <&sys_reset>;
            };
        };

        my_fast_lt: my_fast_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";    // Defines how overlaps are handled
            tapping-term-ms = <150>;     // Time to trigger the hold behavior
            //quick-tap-ms = <150>;        // Allows repeated taps without triggering the layer

            require-prior-idle-ms = <200>; // Prevents accidental layer activation during fast typing
            bindings = <&mo>, <&kp>;

            // Hold = Layer, Tap = Key

            quick-tap-ms = <50>;
        };

        hrl: hrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <1>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <6 7 8 9 10 23 11 22 21 18 19 20 30 43 44 45 31 32 46 47 33 34 48 35 49>;
        };

        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <1>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 0 1 2 3 12 13 14 15 24 25 26 27 36 37 38 39 4 5 16 17 28 29 41 42 40>;
        };

        layer_tap_repeat: layer_tap_repeat {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_REPEAT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Default {
            label = "Def";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp RIGHT_ALT  &kp N1           &kp N2           &kp N3               &kp N4             &kp N5                                                &kp N6                         &kp N7                      &kp N8               &kp N9           &kp N0               &none
&kp LC(SPACE)  &kp Q            &kp W            &kp F                &kp J              &kp COMMA                                             &kp DOT                        &kp L                       &kp U                &kp Y            &kp SQT              &none
&ok_ltm 9 I    &hrl LEFT_GUI A  &hrl LEFT_ALT R  &hrl LEFT_CONTROL S  &hrl LEFT_SHIFT T  &kp G                                                 &kp M                          &hrm LEFT_SHIFT N           &hrm LEFT_CONTROL E  &hrm LEFT_ALT I  &hrm LEFT_GUI O      &ok_ltm 9 I
&mo 8          &my_fast_lt 8 Z  &kp X            &kp C                &kp D              &kp V        &kp C_MUTE    &none                      &kp K                          &kp H                       &kp P                &kp B            &my_fast_lt 8 SLASH  &mo 8
                                &kp DOWN         &kp UP_ARROW         &lt 7 ESC          &lt 2 SPACE  &lt 3 TAB     &layer_tap_repeat 4 ENTER  &layer_tap_repeat 5 BACKSPACE  &layer_tap_repeat 6 DELETE  &kp LEFT_ARROW       &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        BK {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
            >;

            label = "BK";
        };

        Nav {
            bindings = <
&none  &trans    &trans    &trans     &trans                    &trans                                   &trans         &trans     &trans     &trans     &trans     &none
&none  &none     &none     &none      &none                     &none                                    &kp LS(LG(Z))  &kp LG(V)  &kp LG(C)  &kp LG(X)  &kp LG(Z)  &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT                 &none                                    &kp CAPSLOCK   &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &none
&none  &none     &none     &none      &sk LS(LA(LC(LEFT_GUI)))  &kp LS(LA(LC(LG(V))))  &none    &none    &kp INSERT     &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &none
                 &none     &none      &none                     &none                  &none    &kp RET  &kp BSPC       &kp DEL    &none      &none
            >;

            label = "Nav";
            sensor-bindings = <&inc_dec_kp 0 0>, <&inc_dec_kp PG_UP PG_DN>;
        };

        Mouse {
            bindings = <
&bootloader  &none     &none     &none      &none      &none                                    &none     &none           &none           &none         &none            &none
&none        &none     &none     &none      &none      &none                                    &none     &none           &none           &none         &none            &none
&none        &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &kp LS(LG(NUMBER_4))                     &none     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
&none        &none     &none     &none      &none      &none                 &none    &none     &none     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
                       &none     &none      &none      &none                 &none    &mkp MB2  &mkp MB1  &mkp MB3        &none           &none
            >;

            label = "Mouse";
            sensor-bindings = <&inc_dec_kp 0 0>;
        };

        SYM {
            bindings = <
&none  &none          &none         &none          &none          &none                                 &none  &none      &none      &none     &none     &none
&none  &kp LS(LBRC)   &kp LS(AMPS)  &kp LS(STAR)   &kp LS(LPAR)   &kp LS(RBRC)                          &none  &none      &none      &none     &none     &none
&none  &kp LS(COLON)  &kp LS(DLLR)  &kp LS(PRCNT)  &kp LS(CARET)  &kp LS(PLUS)                          &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
&none  &kp LS(TILDE)  &kp LS(EXCL)  &kp LS(AT)     &kp LS(POUND)  &kp LS(PIPE)  &none            &none  &none  &none      &none      &none     &none     &none
                      &none         &none          &kp LS(LPAR)   &kp LS(RPAR)  &kp LS(UNDER)    &none  &none  &none      &none      &none
            >;

            label = "SYM";
        };

        NUM {
            bindings = <
&none  &none      &none   &none   &none    &none                          &none    &none      &none      &none     &none     &none
&none  &kp LBKT   &kp N7  &kp N8  &kp N9   &kp RBKT                       &kp DOT  &kp COMMA  &none      &none     &none     &none
&none  &kp SEMI   &kp N4  &kp N5  &kp N6   &kp EQUAL                      &none    &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
&none  &kp GRAVE  &kp N1  &kp N2  &kp N3   &kp BSLH   &none        &none  &none    &none      &none      &none     &none     &none
                  &none   &none   &kp DOT  &kp N0     &kp MINUS    &none  &none    &none      &none      &none
            >;

            label = "NUM";
        };

        Func {
            bindings = <
&none  &none    &none   &none   &none     &none                        &none  &none      &none      &none     &none     &none
&none  &kp F12  &kp F7  &kp F8  &kp F9    &none                        &none  &none      &none      &none     &none     &none
&none  &kp F11  &kp F4  &kp F5  &kp F6    &none                        &none  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  &none
&none  &kp F10  &kp F1  &kp F2  &kp F3    &none      &none      &none  &none  &none      &none      &none     &none     &none
                &none   &none   &kp LGUI  &kp SPACE  &kp TAB    &none  &none  &none      &none      &none
            >;

            label = "Func";
        };

        Media {
            bindings = <
&bt BT_CLR      &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0                       &none             &none           &none            &none              &none       &ext_power EP_TOG
&out OUT_BLE    &none         &none         &none         &none         &none                              &none             &none           &none            &none              &none       &none
&out OUT_USB    &kp LGUI      &kp LALT      &kp LCTRL     &kp LSHFT     &none                              &none             &kp C_PREVIOUS  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp C_NEXT  &none
&bt BT_CLR_ALL  &none         &none         &none         &none         &none         &none    &none       &none             &none           &none            &none              &none       &studio_unlock
                              &none         &none         &none         &none         &none    &kp C_STOP  &kp C_PLAY_PAUSE  &kp K_MUTE      &none            &none
            >;

            label = "Media";
        };

        Cmd {
            bindings = <
&trans  &trans       &trans     &trans    &trans       &trans                         &trans              &trans            &trans             &trans             &trans  &trans
&trans  &trans       &ok_close  &ok_find  &trans       &trans                         &trans              &trans            &trans             &ok_redo           &trans  &trans
&trans  &ok_sel_all  &trans     &ok_save  &ok_new_tab  &trans                         &trans              &ok_new_win       &trans             &trans             &trans  &trans
&trans  &ok_undo     &ok_cut    &ok_copy  &trans       &ok_paste  &trans    &trans    &trans              &ok_find_replace  &trans             &trans             &trans  &trans
                     &trans     &trans    &trans       &trans     &trans    &leader1  &ok_sel_line_start  &ok_sel_line_end  &ok_sel_prev_word  &ok_sel_next_word
            >;

            label = "CMD";
        };

        Sel {
            bindings = <
&trans  &trans  &trans  &trans  &trans        &trans                          &trans        &trans        &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &ok_prev_app  &ok_next_app                    &trans        &trans        &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &ok_prev_tab  &ok_next_tab                    &ok_prev_app  &ok_next_app  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans        &trans        &trans    &trans  &trans        &trans        &trans  &trans  &trans  &trans
                &trans  &trans  &trans        &trans        &trans    &trans  &trans        &trans        &trans  &trans
            >;

            label = "SEL";
        };
    };
};
